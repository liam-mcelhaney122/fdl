{
  "name": "digital-fdl",
  "version": "1.0.0",
  "description": "Field Definition Language used to build field types",
  "main": "index.js",
  "license": "apache-2.0",
  "private": false,
  "scripts": {
    "example:fdl-input": "vite --config examples/fdl-input/vite.config.mjs examples/fdl-input",
    "example:fdl-input:build": "vite build --config examples/fdl-input/vite.config.mjs examples/fdl-input",
    "portfolio:setup": "npm --prefix portfolio ci",
    "portfolio:dev": "npm --prefix portfolio run dev",
    "portfolio:build": "npm --prefix portfolio run build",
    "portfolio:test": "npm --prefix portfolio test",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "test:watch": "jest --watch",
    "test:debug": "node --inspect-brk node_modules/.bin/jest --runInBand"
  },
  "dependencies": {
    "lit": "^2.2.3",
    "jsdoc": "^3.6.7",
    "ts-jest": "^27.1.3",
    "ts-loader": "^9.3.0",
    "typescript": "^4.6.4"
  },
  "devDependencies": {
    "@open-wc/testing": "2.5.33",
    "@types/jest": "27.5.2",
    "@babel/preset-env": "^7.15.6",
    "@types/node": "18.19.50",
    "babel-jest": "^27.2.1",
    "jest": "^27.2.1",
    "regenerator-runtime": "^0.13.9",
    "vite": "^5.4.19"
  },
  "overrides": {
    "errorstacks": "2.4.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Banno/FDL.git"
  }
}
