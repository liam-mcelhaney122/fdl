{
    "name": "@pmcelhaney/fdl",
    "version": "1.0.0",
    "description": "Field Definition Library used to build field types",
    "main": "index.js",
    "license": "apache-2.0",
    "private": false,
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "docs:dev": "vite --config examples/fdl-input/vite.config.mjs examples/fdl-input",
        "docs:build": "vite build --config examples/fdl-input/vite.config.mjs examples/fdl-input",
        "test": "jest",
        "typecheck": "node node_modules/typescript/bin/tsc --noEmit && npm run typecheck:angular",
        "typecheck:angular": "node node_modules/typescript-angular/bin/tsc -p adapters/angular/tsconfig.json",
        "test:watch": "jest --watch",
        "test:debug": "node --inspect-brk node_modules/.bin/jest --runInBand",
        "format": "node scripts/format-example-snippets.mjs && prettier . --write",
        "format:check": "node scripts/format-example-snippets.mjs --check && prettier . --check"
    },
    "dependencies": {
        "jsdoc": "^3.6.7",
        "lit": "^2.2.3",
        "ts-jest": "^27.1.3",
        "ts-loader": "^9.3.0",
        "typescript": "^4.6.4"
    },
    "peerDependencies": {
        "@angular/core": "^21.0.0"
    },
    "peerDependenciesMeta": {
        "@angular/core": {
            "optional": true
        }
    },
    "devDependencies": {
        "@angular/common": "^21.2.25",
        "@angular/compiler": "^21.2.25",
        "@angular/core": "^21.2.25",
        "@angular/platform-browser": "^21.2.25",
        "@babel/preset-env": "^7.15.6",
        "@open-wc/testing": "2.5.33",
        "@types/jest": "27.5.2",
        "@types/node": "18.19.50",
        "babel-jest": "^27.2.1",
        "esbuild": "^0.21.5",
        "jest": "^27.2.1",
        "prettier": "^3.9.10",
        "regenerator-runtime": "^0.13.9",
        "rxjs": "^7.8.2",
        "typescript-angular": "npm:typescript@~5.9.3",
        "vite": "^5.4.19"
    },
    "overrides": {
        "errorstacks": "2.4.1"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/pmcelhaney/FDL.git"
    }
}
