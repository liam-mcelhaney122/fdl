{
    "name": "@pmcelhaney/fdl",
    "version": "1.0.0",
    "description": "Field Definition Library used to build field types",
    "main": "index.js",
    "license": "apache-2.0",
    "private": false,
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "docs:dev": "vite --config examples/fdl-input/vite.config.mjs examples/fdl-input",
        "docs:build": "vite build --config examples/fdl-input/vite.config.mjs examples/fdl-input",
        "test": "jest",
        "typecheck": "tsc --noEmit",
        "test:watch": "jest --watch",
        "test:debug": "node --inspect-brk node_modules/.bin/jest --runInBand",
        "format": "node scripts/format-example-snippets.mjs && prettier . --write",
        "format:check": "node scripts/format-example-snippets.mjs --check && prettier . --check"
    },
    "dependencies": {
        "jsdoc": "^3.6.7",
        "lit": "^2.2.3",
        "ts-jest": "^27.1.3",
        "ts-loader": "^9.3.0",
        "typescript": "^4.6.4"
    },
    "devDependencies": {
        "@babel/preset-env": "^7.15.6",
        "@open-wc/testing": "2.5.33",
        "@testing-library/react": "^14.3.1",
        "@types/jest": "27.5.2",
        "@types/node": "18.19.50",
        "@types/react": "^18.3.12",
        "@types/react-dom": "^18.3.1",
        "babel-jest": "^27.2.1",
        "esbuild": "^0.21.5",
        "jest": "^27.2.1",
        "prettier": "^3.9.10",
        "prettier-plugin-svelte": "^4.1.1",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "regenerator-runtime": "^0.13.9",
        "svelte": "^5.57.2",
        "vite": "^5.4.19"
    },
    "peerDependencies": {
        "react": "^18.0.0 || ^19.0.0",
        "react-dom": "^18.0.0 || ^19.0.0",
        "svelte": "^5.20.0"
    },
    "peerDependenciesMeta": {
        "react": {
            "optional": true
        },
        "react-dom": {
            "optional": true
        },
        "svelte": {
            "optional": true
        }
    },
    "overrides": {
        "errorstacks": "2.4.1"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/pmcelhaney/FDL.git"
    }
}
